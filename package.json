{
  "name": "ai-trust-dashboard",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsx script/prepare-web-data.ts",
    "dev": "vite",
    "prebuild": "tsx script/prepare-web-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test script/reference-charts.test.ts",
    "build": "npm run typecheck && vite build",
    "prebuild:offline": "tsx script/prepare-web-data.ts",
    "build:offline": "npm run typecheck && vite build --config vite.offline.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
